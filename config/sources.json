{
  "schema": "twin-subactor.sources/v1",
  "maxRepositories": 500,
  "maxTicketsPerRepository": 300,
  "expectedGovernanceStandard": "0.18.1",
  "organizations": [
    {
      "id": "subactor",
      "required": true,
      "governanceExpected": true,
      "role": "runtime-and-product-source",
      "localRoot": {"env": "SUBACTOR_REPOSITORIES_ROOT", "default": "workspace://subactor"},
      "ssotCarriers": [".governance/manifest.json", "dsl-manifest.json", "docs/dsl-manifest.json", "project/TICKETS.md", "VERSION"]
    },
    {
      "id": "wellmanifest",
      "required": true,
      "governanceExpected": true,
      "role": "domain-standard-source",
      "localRoot": {"env": "WELLMANIFEST_REPOSITORIES_ROOT", "default": "workspace://wellmanifest"},
      "ssotCarriers": [".governance/manifest.json", "dsl-manifest.json", "docs/dsl-manifest.json", "standard/manifest.json", "project/TICKETS.md", "VERSION"]
    },
    {
      "id": "uri-twin",
      "required": false,
      "governanceExpected": false,
      "role": "infrastructure-observation-source",
      "localRoot": {"env": "URI_TWIN_REPOSITORIES_ROOT", "default": "workspace://uri-twin"},
      "ssotCarriers": [".governance/manifest.json", "dsl-manifest.json", "project/TICKETS.md", "VERSION"]
    },
    {
      "id": "semcod",
      "required": false,
      "governanceExpected": false,
      "role": "intent-and-code-evidence-tool-source",
      "localRoot": {"env": "SEMCOD_REPOSITORIES_ROOT", "default": "workspace://semcod"},
      "ssotCarriers": [".governance/manifest.json", "dsl-manifest.json", "project/TICKETS.md", "VERSION"]
    },
    {
      "id": "autogrammar",
      "required": false,
      "governanceExpected": false,
      "role": "typed-grammar-and-dsl-tool-source",
      "localRoot": {"env": "AUTOGRAMMAR_REPOSITORIES_ROOT", "default": "workspace://autogrammar"},
      "ssotCarriers": [".governance/manifest.json", "dsl-manifest.json", "docs/dsl-manifest.json", "project/TICKETS.md", "VERSION"]
    },
    {
      "id": "oqlos",
      "required": false,
      "governanceExpected": false,
      "role": "typed-query-language-source",
      "localRoot": {"env": "OQLOS_REPOSITORIES_ROOT", "default": "workspace://oqlos"},
      "ssotCarriers": [".governance/manifest.json", "dsl-manifest.json", "project/TICKETS.md", "VERSION"]
    }
  ],
  "control": {
    "required": true,
    "baseUrlEnv": "SUBACTOR_CONTROL_URL",
    "defaultBaseUrl": "http://127.0.0.1:8091",
    "tokenEnv": "SUBACTOR_ADMIN_TOKEN",
    "timeoutSeconds": 8,
    "maxResponseBytes": 2097152,
    "endpoints": [
      {"id": "system-context", "path": "/api/digital-twin/system-context?format=json"},
      {"id": "system-state", "path": "/api/digital-twin/system-state"}
    ]
  },
  "accountTwin": {
    "schema": "twin-subactor.account-sources/v1",
    "profileId": "twin-subactor-account",
    "accountId": "subactor",
    "databaseEnv": "TWIN_SUBACTOR_ACCOUNT_DB",
    "maxProjectManifests": 1000,
    "localSources": [
      {
        "id": "platform-site-resources",
        "entityType": "project",
        "organizationId": "subactor",
        "required": true,
        "relativePath": "platform/config/site-resources.json",
        "itemKeys": ["resources"],
        "idPrefixToStrip": "workspace:",
        "declaredPathField": "path",
        "maxResponseBytes": 8388608,
        "maxRecords": 1000
      },
      {
        "id": "platform-deployment-bindings",
        "entityType": "deployment-binding",
        "organizationId": "subactor",
        "required": true,
        "relativePath": "platform/config/deployment-bindings/registry.v1.json",
        "itemKeys": ["bindings"],
        "maxResponseBytes": 8388608,
        "maxRecords": 1000
      }
    ],
    "apiSources": [
      {
        "id": "control-organizations",
        "entityType": "organization",
        "required": true,
        "baseUrlEnv": "SUBACTOR_CONTROL_URL",
        "defaultBaseUrl": "http://127.0.0.1:8091",
        "tokenEnv": "SUBACTOR_ADMIN_TOKEN",
        "path": "/api/org/organizations?limit=1000",
        "itemKeys": ["rows", "organizations", "items"],
        "timeoutSeconds": 8,
        "maxResponseBytes": 8388608,
        "maxRecords": 1000
      },
      {
        "id": "control-projects",
        "entityType": "project",
        "required": true,
        "baseUrlEnv": "SUBACTOR_CONTROL_URL",
        "defaultBaseUrl": "http://127.0.0.1:8091",
        "tokenEnv": "SUBACTOR_ADMIN_TOKEN",
        "path": "/api/org/projects?limit=1000",
        "itemKeys": ["rows", "projects", "items"],
        "timeoutSeconds": 8,
        "maxResponseBytes": 8388608,
        "maxRecords": 1000
      },
      {
        "id": "control-project-reconciliation",
        "entityType": "project-reconciliation",
        "required": true,
        "baseUrlEnv": "SUBACTOR_CONTROL_URL",
        "defaultBaseUrl": "http://127.0.0.1:8091",
        "tokenEnv": "SUBACTOR_ADMIN_TOKEN",
        "path": "/api/projects/reconciliation",
        "itemKeys": ["projects", "rows", "items"],
        "timeoutSeconds": 8,
        "maxResponseBytes": 8388608,
        "maxRecords": 1000
      },
      {
        "id": "planfile-tickets",
        "entityType": "ticket",
        "required": true,
        "baseUrlEnv": "SUBACTOR_PLANFILE_URL",
        "defaultBaseUrl": "http://127.0.0.1:8765",
        "tokenEnv": "SUBACTOR_ADMIN_TOKEN",
        "path": "/tickets?sprint=all&offset={offset}&limit={limit}&view=full",
        "itemKeys": ["tickets", "items"],
        "paginated": true,
        "pageSize": 1000,
        "timeoutSeconds": 30,
        "maxResponseBytes": 16777216,
        "maxRecords": 100000
      }
    ]
  },
  "decision": {
    "policyRef": "priority://wellmanifest.com/deterministic-first/v1",
    "lifecycleRef": "lifecycle://wellmanifest.com/service-observe-repair/v1",
    "doctorSkillRef": "skills://subactor/diagnostics/v1",
    "repairProcessRef": "skills://subactor/processes/repair.v1",
    "validatorProcessRef": "skills://subactor/processes/validation.v1"
  }
}
